# Bash interactive configuration.

case $- in
  *i*) ;;
  *) return ;;
esac

export LANG="${LANG:-en_US.UTF-8}"
export LC_CTYPE="${LC_CTYPE:-en_US.UTF-8}"
export EDITOR="${EDITOR:-vim}"
export VISUAL="$EDITOR"
export SYSTEMD_EDITOR="$EDITOR"
export KUBE_EDITOR="$EDITOR"
export ANSIBLE_FORCE_COLOR=true

export PATH="/usr/local/bin:/usr/local/sbin:$HOME/bin:$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/go/bin:$PATH"
export PATH="${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}/bin:$PATH"
if [[ -d "$HOME/.krew/bin" ]]; then
  export PATH="$PATH:$HOME/.krew/bin"
fi

for file in "$HOME/.config/bash/aliases.sh" "$HOME/.config/bash/functions.sh" "$HOME/.config/bash/completions.sh"; do
  if [[ -r "$file" ]]; then
    # shellcheck source=/dev/null
    source "$file"
  fi
done

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook bash)"
fi
